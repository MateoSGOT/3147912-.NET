@model Agenda.ViewModels.Agenda.AgendaIndexVm
@{
    ViewData["Title"] = "Citas eliminadas";
    ViewData["Subtitle"] = "Histórico de citas anuladas (soft delete).";
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="p-4 sm:p-6 border-b border-slate-200">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
            <form method="get" class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
                <input name="search" value="@Model.Search"
                       placeholder="Buscar por placa o cliente..."
                       class="w-full sm:w-80 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm" />

                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                    Buscar
                </button>

                <a asp-action="Eliminadas"
                   class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold hover:bg-slate-50">
                    Limpiar
                </a>
            </form>

            <a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold hover:bg-slate-50">
                Volver a Agenda
            </a>
        </div>
    </div>

    <div class="p-4 sm:p-6">
        @if (Model.Citas.Count == 0)
        {
            <div class="text-sm text-slate-500">No hay citas eliminadas en el rango consultado.</div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var c in Model.Citas)
                {
                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                            <div>
                                <div class="text-sm font-bold">@c.InicioLocal:yyyy-MM-dd HH:mm - @c.FinLocal:HH:mm</div>
                                <div class="mt-1 text-sm text-slate-700">
                                    <span class="font-semibold">@c.Placa</span> · @c.Cliente · @c.TipoServicio
                                </div>
                                <div class="mt-1 text-xs text-slate-600">
                                    Estado: @c.Estado · Prioridad: @c.Prioridad
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <a asp-action="Details" asp-route-id="@c.Id"
                                   class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold hover:bg-slate-50">
                                    Ver
                                </a>

                                <form method="post" asp-action="Restaurar" asp-route-id="@c.Id">
                                    @Html.AntiForgeryToken()
                                    <button class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
                                        Restaurar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
