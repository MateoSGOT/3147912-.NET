@model Agenda.ViewModels.Agenda.CambiarEstadoVm
@{
    ViewData["Title"] = "Cambiar estado";
    ViewData["Subtitle"] = Model.ResumenCita;
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <form method="post" class="p-4 sm:p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CitaId" />
        <input type="hidden" asp-for="EstadoActual" />
        <input type="hidden" asp-for="RowVersionBase64" />

        @if (!string.IsNullOrWhiteSpace(Model.DomainError))
        {
            <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-rose-900">
                <div class="font-semibold">No se pudo cambiar</div>
                <div class="text-sm">@Model.DomainError</div>
            </div>
        }

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <div class="text-sm font-semibold">Estado actual</div>
            <div class="mt-1 text-sm text-slate-700 font-semibold">@Model.EstadoActual</div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Nuevo estado</label>
                <select asp-for="NuevoEstado" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm">
                    @foreach (var e in Model.EstadosPermitidos)
                    {
                        <option value="@e.Id" selected="@( (int)Model.NuevoEstado == e.Id )">@e.Text</option>
                    }
                </select>
                <span class="text-xs text-rose-600">@Html.ValidationMessageFor(m => m.NuevoEstado)</span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Nota (opcional)</label>
                <input asp-for="Nota"
                       class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm"
                       placeholder="Ej: Cliente confirmó por WhatsApp" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
            <a asp-action="Details" asp-route-id="@Model.CitaId"
               class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold hover:bg-slate-50">
                Cancelar
            </a>
            <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                Guardar
            </button>
        </div>
    </form>
</div>
