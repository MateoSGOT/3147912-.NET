@using Microsoft.AspNetCore.Mvc.Rendering
@{
    string Ctrl() => (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    string Act() => (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    bool IsActive(string controller, string? action = null)
        => string.Equals(Ctrl(), controller, StringComparison.OrdinalIgnoreCase)
           && (action == null || string.Equals(Act(), action, StringComparison.OrdinalIgnoreCase));

    string NavItemClass(string controller, string? action = null)
        => IsActive(controller, action)
            ? "group flex items-center gap-3 rounded-xl bg-slate-900 px-3 py-2 text-sm font-semibold text-white shadow-sm"
            : "group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100";

    string IconClass(string controller, string? action = null)
        => IsActive(controller, action)
            ? "h-5 w-5 text-white"
            : "h-5 w-5 text-slate-500 group-hover:text-slate-700";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agenda</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { theme: { extend: {} } }</script>
</head>

<body class="bg-slate-50 text-slate-900">
    <!-- Overlay (mobile) -->
    <div id="appOverlay" class="fixed inset-0 z-40 hidden bg-slate-900/50"></div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="fixed inset-y-0 left-0 z-50 w-80 -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out
                  border-r border-slate-200 bg-white">
        <div class="h-full flex flex-col">

            <!-- Brand -->
            <div class="px-5 py-4 border-b border-slate-200">
                <div class="flex items-center justify-between">
                    <a asp-controller="Agenda" asp-action="Index" class="flex items-center gap-3">
                        <div class="h-11 w-11 rounded-2xl bg-slate-900 flex items-center justify-center shadow-sm">
                            <!-- Logo mark -->
                            <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M8 7V6a2 2 0 012-2h4a2 2 0 012 2v1M6 9h12M7 9v10a2 2 0 002 2h6a2 2 0 002-2V9" />
                            </svg>
                        </div>
                        <div class="leading-tight">
                            <div class="text-sm font-extrabold tracking-tight">Agenda Taller</div>
                            <div class="text-xs text-slate-500">Módulo de programación</div>
                        </div>
                    </a>

                    <button id="btnCloseSidebar"
                            type="button"
                            class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-xl hover:bg-slate-100"
                            aria-label="Cerrar menú">
                        <svg class="h-5 w-5 text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Quick status card -->
                <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex items-start gap-3">
                        <div class="h-10 w-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center">
                            <svg class="h-5 w-5 text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M4 11h16M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <div class="text-sm font-semibold">Panel</div>
                            <div class="text-xs text-slate-600 mt-0.5">
                                Agenda, disponibilidad, reprogramación y control de estados.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="px-4 py-4 overflow-y-auto">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 px-3 mb-2">
                    Agenda
                </div>

                <div class="space-y-1">
                    <a asp-controller="Agenda" asp-action="Index" class="@NavItemClass("Agenda","Index")">
                        <svg class="@IconClass("Agenda", "Index")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 7V3m8 4V3M4 11h16M6 21h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span class="flex-1">Agenda semanal</span>
                        <span class="text-[11px] rounded-full px-2 py-0.5 border border-slate-200 bg-white text-slate-700 @(IsActive("Agenda", "Index") ? "border-white/20 bg-white/10 text-white" : "")">
                            View
                        </span>
                    </a>

                    <a asp-controller="Agenda" asp-action="Create" class="@NavItemClass("Agenda","Create")">
                        <svg class="@IconClass("Agenda", "Create")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 5v14M5 12h14" />
                        </svg>
                        <span class="flex-1">Nueva cita</span>
                    </a>

                    <a asp-controller="Agenda" asp-action="Disponibilidad" class="@NavItemClass("Agenda","Disponibilidad")">
                        <svg class="@IconClass("Agenda", "Disponibilidad")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="flex-1">Disponibilidad</span>
                    </a>

                    <a asp-controller="Agenda" asp-action="Eliminadas" class="@NavItemClass("Agenda","Eliminadas")">
                        <svg class="@IconClass("Agenda", "Eliminadas")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 5h6m2 0h3M4 5h3m2 0V4a1 1 0 011-1h4a1 1 0 011 1v1m-9 4h10l-1 12a2 2 0 01-2 2H9a2 2 0 01-2-2L6 9z" />
                        </svg>
                        <span class="flex-1">Eliminadas</span>
                    </a>
                </div>

                <!-- Collapsible group -->
                <div class="mt-6">
                    <button id="btnTools"
                            type="button"
                            class="w-full flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                        <svg class="h-5 w-5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>

                        <span class="flex-1 text-left">Herramientas</span>

                        <svg id="toolsChevron" class="h-4 w-4 text-slate-500 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <div id="toolsPanel" class="hidden mt-2 pl-3 space-y-1">
                        <a asp-controller="Agenda" asp-action="Index" asp-route-weekStart="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                            <svg class="h-5 w-5 text-slate-500 group-hover:text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="flex-1">Ir a semana actual</span>
                        </a>

                        <a asp-controller="Agenda" asp-action="Create"
                           class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                            <svg class="h-5 w-5 text-slate-500 group-hover:text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                            </svg>
                            <span class="flex-1">Crear cita rápida</span>
                        </a>
                    </div>
                </div>

                <div class="mt-6 px-3">
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Atajos</div>
                        <div class="mt-3 grid grid-cols-2 gap-2">
                            <a asp-controller="Agenda" asp-action="Create"
                               class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100">
                                Nueva cita
                            </a>
                            <a asp-controller="Agenda" asp-action="Disponibilidad"
                               class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100">
                                Ver slots
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Footer -->
            <div class="mt-auto border-t border-slate-200 p-4">
                <div class="rounded-2xl bg-slate-900 p-4 text-white">
                    <div class="text-sm font-semibold">Agenda</div>
                    <div class="text-xs text-white/75 mt-1">
                        Interfaz moderna con Sidebar + Tailwind.
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="lg:pl-80">
        <!-- Topbar -->
        <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <button id="btnOpenSidebar"
                            type="button"
                            class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white hover:bg-slate-50"
                            aria-label="Abrir menú">
                        <svg class="h-5 w-5 text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <div>
                        <div class="text-lg font-extrabold tracking-tight">@ViewData["Title"]</div>
                        @if (ViewData["Subtitle"] is string sub && !string.IsNullOrWhiteSpace(sub))
                        {
                            <div class="text-sm text-slate-600">@sub</div>
                        }
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <a asp-controller="Agenda" asp-action="Create"
                       class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                        </svg>
                        Nueva cita
                    </a>
                </div>
            </div>
        </header>

        <!-- Toasts -->
        <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-4">
            @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
            {
                <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12a8 8 0 11-16 0 8 8 0 0116 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="font-semibold">Éxito</div>
                            <div class="text-sm">@ok</div>
                        </div>
                    </div>
                </div>
            }
            @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
            {
                <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-rose-900">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="font-semibold">Error</div>
                            <div class="text-sm">@err</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Content -->
        <main class="mx-auto max-w-7xl px-4 sm:px-6 pb-10">
            @RenderBody()
        </main>

        <footer class="border-t border-slate-200 bg-white">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 text-sm text-slate-600">
                © @DateTime.Now.Year · Agenda · Sidebar UI
            </div>
        </footer>
    </div>

    <script>
        (function () {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('appOverlay');
            const btnOpen = document.getElementById('btnOpenSidebar');
            const btnClose = document.getElementById('btnCloseSidebar');

            function openSidebar() {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
            function closeSidebar() {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }

            if (btnOpen) btnOpen.addEventListener('click', openSidebar);
            if (btnClose) btnClose.addEventListener('click', closeSidebar);
            if (overlay) overlay.addEventListener('click', closeSidebar);

            // Tools collapse
            const btnTools = document.getElementById('btnTools');
            const toolsPanel = document.getElementById('toolsPanel');
            const chevron = document.getElementById('toolsChevron');

            function setTools(open) {
                if (!toolsPanel || !chevron) return;
                if (open) {
                    toolsPanel.classList.remove('hidden');
                    chevron.classList.add('rotate-180');
                } else {
                    toolsPanel.classList.add('hidden');
                    chevron.classList.remove('rotate-180');
                }
            }

            // Auto-open tools if on Agenda controller but not needed; keep closed by default.
            setTools(false);

            if (btnTools) {
                btnTools.addEventListener('click', () => {
                    const isHidden = toolsPanel.classList.contains('hidden');
                    setTools(isHidden);
                });
            }

            // ESC to close sidebar on mobile
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeSidebar();
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
