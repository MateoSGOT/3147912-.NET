@model Tienda.Models.Venta

@{
    ViewData["Title"] = "Detalles de venta";
}

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800">Detalle de la venta</h1>
            <p class="text-sm text-slate-500">Consulta la información completa de la venta seleccionada.</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Volver a ventas
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <h2 class="text-sm font-semibold text-slate-700 mb-2">Información general</h2>
            <dl class="text-sm text-slate-600 space-y-1">
                <div class="flex justify-between">
                    <dt class="font-medium">Cliente:</dt>
                    <dd>@Model.Cliente?.NombreCompleto</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-medium">Fecha:</dt>
                    <dd>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-medium">Total:</dt>
                    <dd>@Model.Total.ToString("C")</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 overflow-hidden">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-slate-600">Producto</th>
                    <th class="px-4 py-2 text-right font-semibold text-slate-600">Cantidad</th>
                    <th class="px-4 py-2 text-right font-semibold text-slate-600">Precio unitario</th>
                    <th class="px-4 py-2 text-right font-semibold text-slate-600">Subtotal</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var d in Model.DetallesVenta)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-2">@d.Producto?.Nombre</td>
                        <td class="px-4 py-2 text-right">@d.Cantidad</td>
                        <td class="px-4 py-2 text-right">@d.PrecioUnitario.ToString("C")</td>
                        <td class="px-4 py-2 text-right">@d.Subtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
