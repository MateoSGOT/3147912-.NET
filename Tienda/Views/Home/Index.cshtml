@{
    ViewData["Title"] = "Inicio";
}

<div class="space-y-6">
    <!-- Encabezado -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800">Panel principal</h1>
            <p class="text-sm text-slate-500">
                Bienvenido al sistema de gestión de tienda TechNova. Desde aquí puedes administrar clientes, productos y ventas.
            </p>
        </div>
    </div>

    <!-- Tarjetas principales -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a asp-controller="Clientes" asp-action="Index"
           class="block rounded-2xl border border-slate-200 bg-slate-50 hover:bg-slate-100 transition shadow-sm p-4">
            <h2 class="text-sm font-semibold text-slate-700 mb-1">Clientes</h2>
            <p class="text-xs text-slate-500 mb-3">Registra y administra los datos de tus clientes.</p>
            <span class="inline-flex items-center text-xs font-semibold text-indigo-700">
                Ir a clientes →
            </span>
        </a>

        <a asp-controller="Productos" asp-action="Index"
           class="block rounded-2xl border border-slate-200 bg-slate-50 hover:bg-slate-100 transition shadow-sm p-4">
            <h2 class="text-sm font-semibold text-slate-700 mb-1">Productos</h2>
            <p class="text-xs text-slate-500 mb-3">Gestiona el catálogo, precios y stock disponible.</p>
            <span class="inline-flex items-center text-xs font-semibold text-indigo-700">
                Ir a productos →
            </span>
        </a>

        <a asp-controller="Ventas" asp-action="Index"
           class="block rounded-2xl border border-slate-200 bg-slate-50 hover:bg-slate-100 transition shadow-sm p-4">
            <h2 class="text-sm font-semibold text-slate-700 mb-1">Ventas</h2>
            <p class="text-xs text-slate-500 mb-3">Registra ventas, consulta detalles y actualiza stock.</p>
            <span class="inline-flex items-center text-xs font-semibold text-indigo-700">
                Ir a ventas →
            </span>
        </a>
    </div>

    <!-- Sección informativa -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-sm font-semibold text-slate-700 mb-2">¿Qué puedes hacer?</h3>
            <ul class="text-xs text-slate-500 space-y-1 list-disc list-inside">
                <li>Registrar y editar clientes.</li>
                <li>Gestionar productos con precios y stock.</li>
                <li>Crear ventas con múltiples productos.</li>
                <li>Actualizar stock automáticamente por cada venta.</li>
                <li>Proteger el acceso mediante autenticación con Identity.</li>
            </ul>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-sm font-semibold text-slate-700 mb-2">Tecnologías usadas</h3>
            <ul class="text-xs text-slate-500 space-y-1 list-disc list-inside">
                <li>ASP.NET Core MVC</li>
                <li>Entity Framework Core (Database First)</li>
                <li>Identity para autenticación</li>
                <li>SQL Server (TechNovaDB)</li>
                <li>Tailwind CSS para el diseño</li>
            </ul>
        </div>
    </div>
</div>
