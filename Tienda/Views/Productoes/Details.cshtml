@model Tienda.Models.Producto

@{
    ViewData["Title"] = "Detalles del producto";
}

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800">Detalles del producto</h1>
            <p class="text-sm text-slate-500">Consulta la información registrada de este producto.</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Volver a productos
        </a>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 space-y-4">
        <dl class="text-sm text-slate-700 space-y-3">
            <div class="flex justify-between">
                <dt class="font-medium">Nombre</dt>
                <dd>@Model.Nombre</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Código</dt>
                <dd>@Model.Codigo</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Precio unitario</dt>
                <dd>@Model.PrecioUnitario.ToString("C")</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Stock disponible</dt>
                <dd>@Model.StockDisponible</dd>
            </div>
        </dl>

        <div>
            <h2 class="text-sm font-semibold text-slate-700 mb-1">Descripción</h2>
            <p class="text-sm text-slate-600">@Model.Descripcion</p>
        </div>
    </div>

    <div class="flex justify-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ProductoId"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-amber-700 bg-amber-50 hover:bg-amber-100">
            Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.ProductoId"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-rose-700 bg-rose-50 hover:bg-rose-100">
            Eliminar
        </a>
    </div>
</div>
