@model Tienda.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800 text-rose-700">Eliminar producto</h1>
            <p class="text-sm text-slate-500">¿Estás seguro de que deseas eliminar este producto? Esta acción no se puede deshacer.</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Volver a productos
        </a>
    </div>

    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 space-y-4">
        <dl class="text-sm text-slate-700 space-y-3">
            <div class="flex justify-between">
                <dt class="font-medium">Nombre</dt>
                <dd>@Model.Nombre</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Código</dt>
                <dd>@Model.Codigo</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Precio unitario</dt>
                <dd>@Model.PrecioUnitario.ToString("C")</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Stock disponible</dt>
                <dd>@Model.StockDisponible</dd>
            </div>
        </dl>

        <div>
            <h2 class="text-sm font-semibold text-slate-700 mb-1">Descripción</h2>
            <p class="text-sm text-slate-600">@Model.Descripcion</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="flex justify-end gap-2">
        <input type="hidden" asp-for="ProductoId" />

        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Cancelar
        </a>
        <button type="submit"
                class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700">
            Confirmar eliminación
        </button>
    </form>
</div>
