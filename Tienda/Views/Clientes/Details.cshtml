@model Tienda.Models.Cliente

@{
    ViewData["Title"] = "Detalles del cliente";
}

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800">Detalles del cliente</h1>
            <p class="text-sm text-slate-500">Consulta la información registrada de este cliente.</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Volver a clientes
        </a>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <dl class="text-sm text-slate-700 space-y-3">
            <div class="flex justify-between">
                <dt class="font-medium">Nombre completo</dt>
                <dd>@Model.NombreCompleto</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Correo electrónico</dt>
                <dd>@Model.Correo</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Teléfono</dt>
                <dd>@Model.Telefono</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Dirección</dt>
                <dd>@Model.Direccion</dd>
            </div>
        </dl>
    </div>

    <div class="flex justify-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ClienteId"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-amber-700 bg-amber-50 hover:bg-amber-100">
            Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.ClienteId"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-rose-700 bg-rose-50 hover:bg-rose-100">
            Eliminar
        </a>
    </div>
</div>
