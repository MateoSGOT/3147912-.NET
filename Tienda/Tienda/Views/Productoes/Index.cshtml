@model IEnumerable<Tienda.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="flex flex-col gap-4">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800">Gestión de productos</h1>
            <p class="text-sm text-slate-500">Administra el catálogo, precios y stock de los productos.</p>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm">
            + Nuevo producto
        </a>
    </div>

    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-2 gap-3 bg-slate-50 border border-slate-200 rounded-xl p-4">
        <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">Buscar</label>
            <input type="text" name="buscar" class="w-full rounded-lg border-slate-300 text-sm focus:ring-indigo-500 focus:border-indigo-500" placeholder="Nombre o código..." />
        </div>
        <div class="flex items-end">
            <button type="submit"
                    class="w-full inline-flex items-center justify-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700">
                Buscar
            </button>
        </div>
    </form>

    <div class="overflow-hidden border border-slate-200 rounded-xl">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-slate-600">Nombre</th>
                    <th class="px-4 py-2 text-left font-semibold text-slate-600">Código</th>
                    <th class="px-4 py-2 text-right font-semibold text-slate-600">Precio</th>
                    <th class="px-4 py-2 text-right font-semibold text-slate-600">Stock</th>
                    <th class="px-4 py-2 text-right font-semibold text-slate-600">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-2">@item.Nombre</td>
                        <td class="px-4 py-2">@item.Codigo</td>
                        <td class="px-4 py-2 text-right">@item.PrecioUnitario.ToString("C")</td>
                        <td class="px-4 py-2 text-right">@item.StockDisponible</td>
                        <td class="px-4 py-2">
                            <div class="flex justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.ProductoId"
                                   class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100">
                                    Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.ProductoId"
                                   class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100">
                                    Detalles
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ProductoId"
                                   class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
