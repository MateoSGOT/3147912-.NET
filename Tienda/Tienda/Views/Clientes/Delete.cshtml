@model Tienda.Models.Cliente

@{
    ViewData["Title"] = "Eliminar cliente";
}

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-800 text-rose-700">Eliminar cliente</h1>
            <p class="text-sm text-slate-500">¿Estás seguro de que deseas eliminar este cliente? Esta acción no se puede deshacer.</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Volver a clientes
        </a>
    </div>

    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5">
        <dl class="text-sm text-slate-700 space-y-3">
            <div class="flex justify-between">
                <dt class="font-medium">Nombre completo</dt>
                <dd>@Model.NombreCompleto</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Correo electrónico</dt>
                <dd>@Model.Correo</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Teléfono</dt>
                <dd>@Model.Telefono</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Dirección</dt>
                <dd>@Model.Direccion</dd>
            </div>
        </dl>
    </div>

    <form asp-action="Delete" method="post" class="flex justify-end gap-2">
        <input type="hidden" asp-for="ClienteId" />

        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Cancelar
        </a>
        <button type="submit"
                class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700">
            Confirmar eliminación
        </button>
    </form>
</div>
