@model Tienda.Models.Venta
@using Tienda.Models

@{
    ViewData["Title"] = "Edit";
    var productos = ViewBag.Productos as List<Producto>;
}

<h1 class="text-2xl font-semibold text-slate-800 mb-1">Nueva venta</h1>
<p class="text-sm text-slate-500 mb-4">Selecciona el cliente y los productos que harán parte de la venta.</p>

<form asp-action="Edit" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 mb-2"></div>

    <!-- Cliente -->
    <div>
        <label asp-for="ClienteId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="ClienteId" class="w-full rounded-lg border-slate-300 text-sm focus:ring-indigo-500 focus:border-indigo-500" asp-items="ViewBag.ClienteId">
            <option value="">-- Seleccione un cliente --</option>
        </select>
        <span asp-validation-for="ClienteId" class="text-xs text-rose-600"></span>
    </div>

    <!-- Productos -->
    <div class="border border-slate-200 rounded-xl p-4 bg-slate-50">
        <div class="flex items-center justify-between mb-3">
            <h4 class="text-sm font-semibold text-slate-700">Productos de la venta</h4>
            <button type="button"
                    class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium text-indigo-700 bg-white hover:bg-indigo-50 border border-indigo-200"
                    onclick="agregarProducto()">
                + Agregar producto
            </button>
        </div>

        <div id="productosContainer" class="space-y-2">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 producto-row">
                <div class="md:col-span-7">
                    <select name="ProductoId" class="w-full rounded-lg border-slate-300 text-sm focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">-- Seleccione un producto --</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.ProductoId">
                                @p.Nombre (@p.StockDisponible en stock)
                            </option>
                        }
                    </select>
                </div>
                <div class="md:col-span-3">
                    <input type="number" name="Cantidad" class="w-full rounded-lg border-slate-300 text-sm focus:ring-indigo-500 focus:border-indigo-500" min="1" placeholder="Cantidad" />
                </div>
                <div class="md:col-span-2 flex items-center">
                    <button type="button"
                            class="inline-flex items-center justify-center w-full md:w-auto px-3 py-1 rounded-lg text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100"
                            onclick="eliminarFila(this)">
                        Quitar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Botones -->
    <div class="flex justify-end gap-2 pt-2">
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200">
            Cancelar
        </a>
        <button type="submit"
                class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700">
            Guardar venta
        </button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function agregarProducto() {
            const container = document.getElementById('productosContainer');
            const filaOriginal = container.querySelector('.producto-row');
            const nuevaFila = filaOriginal.cloneNode(true);

            nuevaFila.querySelector('select[name="ProductoId"]').selectedIndex = 0;
            nuevaFila.querySelector('input[name="Cantidad"]').value = '';

            container.appendChild(nuevaFila);
        }

        function eliminarFila(button) {
            const container = document.getElementById('productosContainer');
            const filas = container.getElementsByClassName('producto-row');
            if (filas.length > 1) {
                button.closest('.producto-row').remove();
            }
        }
    </script>
}
